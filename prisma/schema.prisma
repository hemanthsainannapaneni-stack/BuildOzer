generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== MASTER TABLES =====================

model Contractor {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // e.g. "BSR"
  gstNumber String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers            Worker[]
  sites              Site[]
  vehicles           Vehicle[]
  legalCompliances   LegalCompliance[]
  incidents          Incident[]
  systemUsers        SystemUser[]
  labourCamps        LabourCamp[]
}

model Site {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  contractorId String?
  contractor  Contractor? @relation(fields: [contractorId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers           Worker[]
  vehicles          Vehicle[]
  incidents         Incident[]
  siteFacilities    SiteFacility[]
  siteSecurityItems SiteSecurityItem[]
  medInfraItems     MedInfraItem[]
  hazardousMaterials HazardousMaterial[]
  labourCamps       LabourCamp[]
  systemUsers       SystemUser[]
}

model Designation {
  id          String @id @default(cuid())
  name        String @unique // e.g. "Mason", "Electrician", "Rigger"
  category    String @default("General") // General, Safety-Critical, Supervisory
  description String?
  isActive    Boolean @default(true)

  workers Worker[]
}

// ===================== MODULE 1: WORKER REGISTRATION =====================

model Worker {
  id                String   @id @default(cuid())
  employeeNumber    String   @unique // APCRDA-0001
  fullName          String
  dateOfBirth       DateTime
  age               Int      // computed, stored for easy querying
  gender            String   // Male, Female, Other
  aadhaarNumber     String   // 12-digit, masked in display
  aadhaarScanPath   String?
  permanentAddress  String
  currentAddress    String?
  bloodGroup        String   // A+, A-, B+, B-, AB+, AB-, O+, O-
  qualification     String   // Below 10th, 10th, 12th, ITI, Diploma, Graduate, Other
  qualificationNote String?
  designationId     String
  designation       Designation @relation(fields: [designationId], references: [id])
  contractorId      String
  contractor       Contractor @relation(fields: [contractorId], references: [id])
  siteId            String?
  site              Site?      @relation(fields: [siteId], references: [id])
  zone              String?   // Zone/Block on site
  nativeState       String?   // Indian state the worker is from
  policeRecords     String   @default("Not Updated") // Updated, Not Updated, Not Applicable
  labourCampId      String?
  labourCamp        LabourCamp? @relation(fields: [labourCampId], references: [id])
  reportingSupervisor String?
  uanNumber         String?   // Universal Account Number for PF
  profilePhotoPath  String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  emergencyContacts   EmergencyContact[]
  nominees            Nominee[]
  fitness             WorkerFitness?
  medicalRecords      MedicalRecord[]
  trainingRecords     TrainingRecord[]
  attendances         Attendance[]
  insurances          Insurance[]
  wageRecords         WageRecord[]
  incidents           IncidentWorker[]
  drivenVehicles      Vehicle[] @relation("VehicleDriver")
}

model EmergencyContact {
  id         String  @id @default(cuid())
  workerId   String
  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  name       String
  relationship String
  phone      String
  isPrimary  Boolean @default(false)
}

model Nominee {
  id           String  @id @default(cuid())
  workerId     String
  worker       Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  name         String
  relationship  String
  idNumber     String?
  contactNumber String?
}

// ===================== MODULE 2: FITNESS & EXPERIENCE =====================

model WorkerFitness {
  id                    String    @id @default(cuid())
  workerId              String    @unique
  worker                Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  fitnessStatus         String    @default("Pending") // Fit, Unfit, FitWithRestriction, Pending
  fitnessCertificatePath String?
  fitnessValidityDate   DateTime?
  totalExperienceYears  Float     @default(0)
  relevantExperienceYears Float    @default(0)
  relevantExperienceDesc String?
  priorEmployer         String?
  skillLevel            String    @default("Unskilled") // Skilled, SemiSkilled, Unskilled
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ===================== MODULE 3: MEDICAL EXAMINATION =====================

model MedicalRecord {
  id                      String    @id @default(cuid())
  workerId                String
  worker                  Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  examinationDate         DateTime
  examinationType         String    @default("PreEmployment") // PreEmployment, Periodic, Special
  examiningDoctor         String?
  examiningFacility       String?
  result                  String    @default("Pending") // Fit, Unfit, Conditional, Pending
  previousHealthIssues    String?   // JSON array of strings
  chronicDiseases         String?   // JSON array: diabetes, hypertension, asthma, cardiac
  chronicDiseaseNotes     String?
  currentMedications      String?   // JSON array of {drug, dosage, frequency}
  pastSurgeries           String?   // JSON array of {procedure, date, notes}
  nextCheckupDate         DateTime?
  checkupFrequencyMonths  Int       @default(12)
  certificatePath         String?
  photoPaths              String?    // JSON array of photo paths/base64
  photos                  String?    // JSON array of base64 data URLs (examination photos)
  remarks                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// ===================== MODULE 4: TRAINING & CERTIFICATION =====================

model TrainingRecord {
  id                  String    @id @default(cuid())
  workerId            String
  worker              Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  trainingType        String    // JobSpecific, SafetyInduction, POSH, Special, MockDrill
  trainingTitle       String
  dateConducted       DateTime
  durationHours       Float
  trainerName         String?
  trainerCredentials  String?
  trainingAgency      String?
  certificateNumber   String?
  certificatePath     String?
  validityDate        DateTime?
  status              String    @default("Valid") // Valid, ExpiringSoon, Expired
  isCompleted         Boolean   @default(false)
  photoPaths          String?    // JSON array of photo paths/base64 (training session photos)
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ===================== MODULE 5b: ATTENDANCE =====================

model Attendance {
  id              String   @id @default(cuid())
  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date            DateTime
  status          String   @default("Present") // Present, Absent, HalfDay, Leave
  shiftTiming     String?  // e.g. "6AM-2PM"
  isBiometric     Boolean  @default(false)
  overtimeHours   Float?   @default(0)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workerId, date])
}

// ===================== MODULE 5c: INSURANCE =====================

model Insurance {
  id                String   @id @default(cuid())
  workerId          String
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  policyType        String   // WC, ESI, GroupPersonalAccident
  policyNumber      String
  insurerName       String?
  coverageAmount    Float?
  validityStartDate DateTime?
  validityEndDate   DateTime?
  nomineeName       String?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ===================== MODULE 5d: WAGE & PF =====================

model WageRecord {
  id                  String   @id @default(cuid())
  workerId            String
  worker              Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  month                String   // e.g. "2025-01"
  dailyRate           Float?
  monthlyRate         Float?
  wageCategory        String?  // Skilled, SemiSkilled, Unskilled
  workingDays         Int      @default(0)
  totalWages          Float    @default(0)
  overtimeAmount      Float    @default(0)
  deductionPF         Float    @default(0)
  deductionESI        Float    @default(0)
  deductionOther      Float    @default(0)
  netPay              Float    @default(0)
  bankAccountNumber   String?
  uanNumber           String?  // Universal Account Number for PF
  pfContributionPct   Float?   @default(12)
  employerPF          Float?   @default(0)
  employeePF          Float?   @default(0)
  esiNumber           String?
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([workerId, month])
}

// ===================== MODULE 5i: INCIDENT REGISTER =====================

model Incident {
  id                  String    @id @default(cuid())
  incidentNumber      String    @unique
  incidentType        String    // FireInjury, MinorInjury, MajorFatalInjury, Death
  date                DateTime
  time                String?   // HH:mm format
  locationOnSite      String?
  description         String
  rootCause           String?
  immediateAction     String?
  firstResponder      String?
  hospitalReferred    String?
  severity            String    @default("Medium") // Low, Medium, High, Critical
  status              String    @default("Open") // Open, UnderInvestigation, Closed
  isDeath             Boolean   @default(false)
  policeFIRReference  String?
  employerNotifiedAt  DateTime?
  compensationStatus  String?   // NotApplicable, Initiated, InProgress, Completed
  familyNotified      Boolean   @default(false)
  closureStatus       String?   // N/A, Pending, Partial, Complete
  contractorId        String?
  contractor          Contractor? @relation(fields: [contractorId], references: [id])
  siteId              String?
  site                Site?       @relation(fields: [siteId], references: [id])
  photoPaths           String?    // JSON array of photo paths/base64
  photos               String?    // JSON array of base64 data URLs (evidence photos)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workers      IncidentWorker[]
  followUps    IncidentFollowUp[]
}

model IncidentWorker {
  id         String  @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  workerId   String?
  worker     Worker?  @relation(fields: [workerId], references: [id])
  workerName String? // denormalized for safety
  injuryDesc String?
}

model IncidentFollowUp {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action          String
  dueDate         DateTime?
  responsiblePerson String?
  completed       Boolean  @default(false)
  completedAt     DateTime?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===================== MODULE 6: GRIEVANCE REDRESSAL =====================

model Grievance {
  id              String    @id @default(cuid())
  grievanceNumber String    @unique
  dateRaised      DateTime  @default(now())
  raisedBy        String?   // Worker ID or null for anonymous
  raisedByName    String?
  category        String    // Wage, Safety, Harassment, Facility, Other
  isPOSH          Boolean   @default(false)
  description     String
  severity        String    @default("Medium") // Low, Medium, High, Critical
  assignedTo      String?   // SafetyOfficer, PMC, HR
  status          String    @default("Open") // Open, InProgress, Resolved, Escalated
  resolutionDetails String?
  resolutionDate  DateTime?
  closedBy        String?
  photoPaths       String?    // JSON array of photo paths/base64
  photos           String?    // JSON array of base64 data URLs (evidence photos)
  slaDays         Int       @default(7)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ===================== MODULE 7: VEHICLES =====================

model Vehicle {
  id                String   @id @default(cuid())
  vehicleNumber     String
  vehicleType       String   // Dumper, JCB, Crane, Tanker, Passenger, Other
  owner             String   @default("Contractor") // Contractor, Rented
  condition         String   @default("Fit") // Fit, NeedsRepair, Grounded
  lastInspectionDate DateTime?
  nextInspectionDue DateTime?
  contractorId      String?
  contractor        Contractor? @relation(fields: [contractorId], references: [id])
  siteId            String?
  site              Site?       @relation(fields: [siteId], references: [id])
  driverId          String?
  driver            Worker?     @relation("VehicleDriver", fields: [driverId], references: [id])
  photoPath         String?   // vehicle/equipment photo
  photos            String?   // JSON array of base64 encoded photo data URLs
  currentQRCode     String?   // JSON string { qrDataUrl, generatedAt, content }
  qrCodeHistory     String?   // JSON array of previous QR codes
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents VehicleDocument[]
}

model VehicleDocument {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType         String   // RC, Fitness, Insurance, PUC, Permit
  docNumber       String?
  issueDate       DateTime?
  expiryDate      DateTime?
  uploadPath      String?
  status          String   @default("Valid") // Valid, ExpiringSoon, Expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===================== MODULE 8: HAZARDOUS MATERIALS =====================

model HazardousMaterial {
  id                        String   @id @default(cuid())
  materialName              String
  category                  String   @default("General") // General, Hazardous, Chemical
  hazardClassification      String?  // Flammable, Corrosive, Toxic, etc.
  msdsUploadPath            String?
  photoPath                 String?   // material/equipment photo
  photos                    String?   // JSON array of base64 data URLs (storage/labeling photos)
  storageLicenseNumber      String?
  storageLicenseExpiry      DateTime?
  quantityCurrent           Float    @default(0)
  quantityMaxPermissible    Float
  unit                      String   @default("KG")
  storageLocation           String?
  storageConditionCompliant Boolean  @default(true)
  handlingResponsiblePerson String?
  emergencyProcedureRef     String?
  siteId                    String?
  site                      Site?    @relation(fields: [siteId], references: [id])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  transactions MaterialTransaction[]
}

model MaterialTransaction {
  id                 String   @id @default(cuid())
  materialId         String
  material           HazardousMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  transactionType    String   // In, Out
  quantity           Float
  runningBalance     Float
  date               DateTime @default(now())
  remarks            String?
  createdAt          DateTime @default(now())
}

// ===================== MODULE 5j: LEGAL COMPLIANCE =====================

model LegalCompliance {
  id                  String   @id @default(cuid())
  contractorId        String
  contractor          Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  complianceType      String   // LabourLicense, BOCW, ContractLabour, StatutoryRegister
  licenseNumber       String?
  issuingAuthority    String?
  issueDate           DateTime?
  expiryDate          DateTime?
  renewalReminderDays Int      @default(30)
  status              String   @default("Valid") // Valid, ExpiringSoon, Expired
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ===================== SITE-LEVEL CHECKLISTS =====================

model SiteFacility {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item            String   // Shelter, DrinkingWater, Cleanliness, Washroom, WasteDisposal, etc.
  status          String   @default("Compliant") // Compliant, NonCompliant, Pending
  lastInspectionDate DateTime?
  inspector       String?
  remarks         String?
  photos          String?   // JSON array of base64 data URLs
  records         String?   // JSON array of inspection records { date, inspector, status, remarks, photosCount }
  usageDetails    String?   // JSON { dailyUsage, weeklyUsage, lastUsed, capacity }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSecurityItem {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item            String   // PPE, Barricading, ToolSafety, Signboard
  status          String   @default("Compliant") // Compliant, NonCompliant, Pending
  compliancePct   Float?   @default(100)
  lastInspectionDate DateTime?
  inspector       String?
  remarks         String?
  photos          String?   // JSON array of base64 data URLs
  records         String?   // JSON array of inspection records { date, inspector, status, remarks, photosCount }
  usageDetails    String?   // JSON { dailyUsage, weeklyUsage, lastUsed, capacity }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MedInfraItem {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item            String   // MedicalRoom, FirstAidKit, Ambulance, HealthCheckup, MedicalCamp
  status          String   @default("Compliant") // Compliant, NonCompliant, Pending
  details         String?  // JSON with additional info
  lastInspectionDate DateTime?
  inspector       String?
  remarks         String?
  photos          String?   // JSON array of base64 data URLs
  records         String?   // JSON array of inspection records { date, inspector, status, remarks, photosCount }
  usageDetails    String?   // JSON { dailyUsage, weeklyUsage, lastUsed, capacity }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===================== CROSS-CUTTING: SYSTEM USER =====================

model SystemUser {
  id            String   @id @default(cuid())
  username      String   @unique
  password      String   // hashed in real app, plain for demo
  fullName      String
  role          String   // ADMIN, SAFETY_OFFICER, PMC, HR_COORDINATOR, LEGAL_ADVISOR
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  siteId        String?   // PMC users are scoped to a specific site/project
  site          Site?       @relation(fields: [siteId], references: [id])
  profilePhoto  String?  // base64 or file path
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===================== CROSS-CUTTING: AUDIT LOG =====================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String   // CREATE, UPDATE, DELETE
  entity    String   // Worker, MedicalRecord, TrainingRecord, etc.
  entityId  String?
  field     String?  // which field changed
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
}

// ===================== LABOUR CAMP =====================

model LabourCamp {
  id            String   @id @default(cuid())
  name          String
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  address       String?
  capacity      Int?
  currentOccupancy Int?   @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workers Worker[]
}

// ===================== CROSS-CUTTING: NOTIFICATIONS =====================

model Notification {
  id          String   @id @default(cuid())
  type        String   // TrainingExpiry, MedicalDue, VehicleDocExpiry, LicenseRenewal, GrievanceSLA, MaterialNearLimit
  title       String
  message     String
  entityType  String?  // Worker, Vehicle, Material, etc.
  entityId    String?
  isRead      Boolean  @default(false)
  priority    String   @default("Medium") // Low, Medium, High, Critical
  createdAt   DateTime @default(now())
}
